config_version=5

[application]
config/name="Astra — La Poterne des cendres"
run/main_scene="res://scenes/vertical_slice.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.1, 1)
2d/snap/snap_2d_transforms_to_pixel=true

[layer_names]
2d_physics/layer_1="Terrain"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":81), Object(InputEventKey,"keycode":65), Object(InputEventKey,"keycode":4194319)]
}

move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":68), Object(InputEventKey,"keycode":4194321)]
}

jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":32)]
}

attack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":74), Object(InputEventKey,"keycode":88)]
}

interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":69)]
}

restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":82)]
}

pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194305)]
}
